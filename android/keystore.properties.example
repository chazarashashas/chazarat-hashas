# Copy this file to keystore.properties (same folder) and fill in the
# real values — that file is gitignored and must never be committed.
#
# storeFile is relative to the android/app/ directory, so if your
# keystore lives at android/chazarat-hashas-release.keystore, the value
# here is ../chazarat-hashas-release.keystore.
storeFile=../chazarat-hashas-release.keystore
storePassword=
keyAlias=chazarat-hashas
keyPassword=
