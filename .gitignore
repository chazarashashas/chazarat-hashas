# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dev-dist
*.local

# Android: the web build Capacitor copies in on every `npx cap sync
# android` — regenerated from dist/, not source. Run that sync before
# building so this folder reflects the latest web code.
android/app/src/main/assets/public
android/app/src/main/assets/capacitor.config.json

# Android release signing — the keystore is the one file that can never
# be regenerated or recovered if lost, and it must never be public.
android/keystore.properties
*.keystore
*.jks

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
